{
  "name": "@nixypanda/dsh-codect",
  "description": "Codect sidebar plugin for DeepSeek Harness — focused projection show and diff views",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/api-codect/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/api-codect/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/shared/schema.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/types/api-codect/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "typescript": "^5.0.0",
    "esbuild": "^0.24.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ]
}
